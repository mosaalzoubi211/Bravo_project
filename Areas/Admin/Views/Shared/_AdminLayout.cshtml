<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - إدارة برافو</title>

    <!-- Bootstrap 5 RTL CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
            :root {
                --lime: #a3e635;
                --bg-dark: #121212;
                --bg-surface: #1a1a1a;
                --border-color: #333;
                --text-main: #f3f4f6;
                --text-muted: #9ca3af;
            }

            body {
                background-color: var(--bg-dark);
                color: var(--text-main);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                overflow-x: hidden;
                margin: 0;
            }

            /* --- Sidebar Styling --- */
            .admin-sidebar {
                width: 260px;
                background-color: var(--bg-surface);
                border-left: 1px solid var(--border-color);
                position: fixed;
                top: 0;
                bottom: 0;
                right: 0;
                z-index: 1000;
                display: flex;
                flex-direction: column;
            }

            .sidebar-brand {
                padding: 24px;
                font-size: 1.8rem;
                font-weight: 900;
                color: var(--lime);
                text-align: center;
                border-bottom: 1px solid var(--border-color);
                text-decoration: none;
                letter-spacing: 1px;
            }

            .sidebar-menu {
                padding: 20px 15px;
                list-style: none;
                margin: 0;
                flex-grow: 1;
            }

            .menu-item {
                margin-bottom: 8px;
            }

            .menu-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 20px;
                color: var(--text-muted);
                text-decoration: none;
                border-radius: 8px;
                font-weight: 600;
                font-size: 1.05rem;
                transition: all 0.3s ease;
            }

                .menu-link:hover {
                    color: #000;
                    background-color: var(--lime);
                }

            .menu-item.active .menu-link {
                color: #000;
                background-color: var(--lime);
                box-shadow: 0 4px 15px rgba(163, 230, 53, 0.4);
            }

            /* --- Main Content Styling --- */
            .admin-main {
                margin-right: 260px; /* لترك مساحة للشريط الجانبي */
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* --- Top Navbar --- */
            .admin-topbar {
                background-color: var(--bg-surface);
                border-bottom: 1px solid var(--border-color);
                padding: 15px 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                position: sticky;
                top: 0;
                z-index: 999;
            }

            .admin-content {
                padding: 30px;
                flex-grow: 1;
            }

            /* --- Card & Table Global Styling --- */
            .brav-card {
                background-color: var(--bg-surface);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                box-shadow: 0 4px 6px rgba(0,0,0,0.2);
            }
    </style>
</head>
<body>

    <!-- القائمة الجانبية -->
    <aside class="admin-sidebar">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="sidebar-brand">
            Bravo<span style="color: white;">Admin</span>
        </a>

        <ul class="sidebar-menu">
            <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="menu-link">
                    <i class="bi bi-grid-1x2-fill"></i> نظرة عامة
                </a>
            </li>
            <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="menu-link">
                    <i class="bi bi-tools"></i> إدارة التخصصات
                </a>
            </li>
            <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="menu-link">
                    <i class="bi bi-people"></i> إدارة المستخدمين
                </a>
            </li>
        </ul>

        <!-- زر تسجيل الخروج في أسفل القائمة -->
        <div style="padding: 20px; border-top: 1px solid var(--border-color);">
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="~/" method="post">
                <button type="submit" class="btn btn-outline-danger w-100 fw-bold rounded-3">
                    <i class="bi bi-box-arrow-right me-2"></i> تسجيل الخروج
                </button>
            </form>
        </div>
    </aside>

    <!-- منطقة المحتوى -->
    <main class="admin-main">

        <!-- الشريط العلوي -->
        <header class="admin-topbar">
            <div>
                <h5 class="m-0 fw-bold" style="color: var(--text-main);">مرحباً بك، أيها المدير 👑</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex justify-content-center align-items-center fw-bold" style="width: 40px; height: 40px; background-color: var(--lime); color: #000;">
                    A
                </div>
            </div>
        </header>

        <!-- الشاشات الديناميكية -->
        <div class="admin-content">
            @RenderBody()
        </div>

    </main>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>