@model IEnumerable<Bravo.Models.ServiceTask>
@{
    ViewData["Title"] = "لوحة التحكم";
}

<style>
    /* تصميم مخصص لبطاقات الإحصائيات */
    .stat-card {
        padding: 24px;
        border-radius: 16px;
        transition: transform 0.2s ease;
        position: relative;
        overflow: hidden;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.8rem;
    }

    .stat-title {
        color: var(--text-muted);
        font-size: 1rem;
        margin-bottom: 8px;
    }

    .stat-number {
        color: var(--text-main);
        font-size: 2.2rem;
        font-weight: 800;
        margin: 0;
    }

    /* تخصيص الجدول */
    .table-dark-custom {
        color: var(--text-main);
    }

        .table-dark-custom thead th {
            background-color: rgba(0,0,0,0.3) !important;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border-color);
            padding: 16px;
            font-weight: 600;
        }

        .table-dark-custom tbody td {
            background-color: transparent !important;
            border-bottom: 1px solid var(--border-color);
            padding: 16px;
            color: var(--text-main);
            vertical-align: middle;
        }

        .table-dark-custom tbody tr:hover td {
            background-color: rgba(255,255,255,0.02) !important;
        }
</style>

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: var(--text-main);">نظرة عامة على المنصة</h3>
        <p class="m-0" style="color: var(--text-muted);">ملخص سريع لأداء منصة برافو اليوم.</p>
    </div>
</div>

<!-- صف بطاقات الإحصائيات -->
<div class="row g-4 mb-5">

    <!-- إجمالي العملاء -->
    <div class="col-md-3">
        <div class="brav-card stat-card" style="border-bottom: 4px solid #3b82f6;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-title">إجمالي العملاء</div>
                    <div class="stat-number">@ViewBag.TotalClients</div>
                </div>
                <div class="stat-icon" style="background-color: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- إجمالي الحرفيين -->
    <div class="col-md-3">
        <div class="brav-card stat-card" style="border-bottom: 4px solid #f59e0b;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-title">الحرفيين المسجلين</div>
                    <div class="stat-number">@ViewBag.TotalWorkers</div>
                </div>
                <div class="stat-icon" style="background-color: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                    <i class="bi bi-person-lines-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- إجمالي الطلبات (ليموني) -->
    <div class="col-md-3">
        <div class="brav-card stat-card" style="border-bottom: 4px solid var(--lime);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-title">إجمالي الطلبات</div>
                    <div class="stat-number" style="color: var(--lime);">@ViewBag.TotalTasks</div>
                </div>
                <div class="stat-icon" style="background-color: rgba(163, 230, 53, 0.1); color: var(--lime);">
                    <i class="bi bi-card-checklist"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- التخصصات المفعلة -->
    <div class="col-md-3">
        <div class="brav-card stat-card" style="border-bottom: 4px solid #ec4899;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-title">التخصصات المفعلة</div>
                    <div class="stat-number">@ViewBag.TotalCategories</div>
                </div>
                <div class="stat-icon" style="background-color: rgba(236, 72, 153, 0.1); color: #ec4899;">
                    <i class="bi bi-tags-fill"></i>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- جدول أحدث الطلبات -->
<div class="brav-card overflow-hidden">
    <div class="p-4 border-bottom" style="border-color: var(--border-color) !important;">
        <h5 class="m-0 fw-bold" style="color: var(--text-main);"><i class="bi bi-clock-history me-2" style="color: var(--lime);"></i> أحدث الطلبات في المنصة</h5>
    </div>

    <div class="table-responsive">
        <table class="table table-dark-custom w-100 m-0">
            <thead>
                <tr>
                    <th>رقم الطلب</th>
                    <th>اسم العميل</th>
                    <th>التاريخ</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5" style="color: var(--text-muted);">لا توجد طلبات مسجلة حتى الآن.</td>
                    </tr>
                }
                else
                {
                    foreach (var task in Model)
                    {
                        <tr>
                            <td class="fw-bold" style="color: var(--text-muted);">
                                #@task.Id.Substring(0, 8)
                            </td>
                            <td class="fw-bold">@(task.Client?.FullName ?? "غير محدد")</td>
                            <td>@task.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                            <td>
                                @if (task.Status == Bravo.Models.TaskStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="bi bi-hourglass-split me-1"></i> قيد الانتظار</span>
                                }
                                else if (task.Status == Bravo.Models.TaskStatus.ReceivingOffers)
                                {
                                    <span class="badge bg-info text-dark px-3 py-2 rounded-pill"><i class="bi bi-broadcast me-1"></i> يتلقى عروض</span>
                                }
                                else if (task.Status == Bravo.Models.TaskStatus.Accepted)
                                {
                                    <span class="badge bg-primary px-3 py-2 rounded-pill"><i class="bi bi-gear-fill me-1"></i> قيد التنفيذ</span>
                                }
                                else if (task.Status == Bravo.Models.TaskStatus.Completed)
                                {
                                    <span style="background-color: var(--lime); color: #000;" class="badge px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> مكتمل</span>
                                }
                                else if (task.Status == Bravo.Models.TaskStatus.Cancelled)
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i> ملغى</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>