@model IEnumerable<Bravo.Models.AppUser>
@{
    ViewData["Title"] = "إدارة المستخدمين";
    UserRole? selectedRole = ViewBag.SelectedRole as UserRole?;
}

<style>
    .brav-filter-btn {
        background-color: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        transition: all 0.3s ease;
    }

        .brav-filter-btn:hover, .brav-filter-btn.active {
            background-color: var(--lime);
            color: #000;
            border-color: var(--lime);
            font-weight: bold;
        }
</style>

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: var(--text-main);">إدارة المستخدمين 👥</h3>
        <p class="m-0" style="color: var(--text-muted);">تحكم بحسابات العملاء والحرفيين (حظر أو تفعيل).</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success fw-bold border-0 text-center" style="background-color: rgba(163, 230, 53, 0.1); color: var(--lime); border-radius: 12px;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="brav-card overflow-hidden">

    <!-- أزرار الفلترة -->
    <div class="p-4 border-bottom d-flex gap-2" style="border-color: var(--border-color) !important;">
        <a asp-action="Index" asp-route-role="" class="btn brav-filter-btn rounded-pill px-4 @(selectedRole == null ? "active" : "")">
            الجميع
        </a>
        <a asp-action="Index" asp-route-role="@UserRole.Client" class="btn brav-filter-btn rounded-pill px-4 @(selectedRole == UserRole.Client ? "active" : "")">
            العملاء فقط
        </a>
        <a asp-action="Index" asp-route-role="@UserRole.Worker" class="btn brav-filter-btn rounded-pill px-4 @(selectedRole == UserRole.Worker ? "active" : "")">
            الحرفيين فقط
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark-custom w-100 m-0">
            <thead>
                <tr>
                    <th>الاسم الكامل</th>
                    <th>البريد الإلكتروني</th>
                    <th>نوع الحساب</th>
                    <th>الحالة</th>
                    <th class="text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5" style="color: var(--text-muted);">لا يوجد مستخدمين مسجلين في هذا القسم.</td>
                    </tr>
                }
                else
                {
                    foreach (var user in Model)
                    {
                        bool isBanned = user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow;

                        <tr>
                            <td class="fw-bold" style="color: var(--text-main);">
                                <i class="bi bi-person-circle me-2" style="color: var(--text-muted);"></i> @user.FullName
                            </td>
                            <td style="color: var(--text-muted);">@user.Email</td>
                            <td>
                                @if (user.Role == UserRole.Worker)
                                {
                                    <span class="badge bg-label-warning px-3 py-2 rounded-pill"><i class="bi bi-tools me-1"></i> حرفي</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-info px-3 py-2 rounded-pill"><i class="bi bi-person me-1"></i> عميل</span>
                                }
                            </td>
                            <td>
                                @if (isBanned)
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-slash-circle me-1"></i> محظور</span>
                                }
                                else
                                {
                                    <span class="badge px-3 py-2 rounded-pill" style="background-color: rgba(163, 230, 53, 0.1); color: var(--lime);"><i class="bi bi-check-circle me-1"></i> نشط</span>
                                }
                            </td>
                            <td class="text-end">
                                <!-- زر إيقاف وتفعيل الحساب -->
                                <form asp-action="ToggleStatus" method="post" style="display: inline;">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm fw-bold rounded-3 @(isBanned ? "btn-outline-success" : "btn-outline-danger")">
                                        @(isBanned ? "رفع الحظر ✅" : "إيقاف الحساب 🚫")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>