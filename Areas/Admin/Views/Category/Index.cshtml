@model IEnumerable<Bravo.Models.Category>
@{
    ViewData["Title"] = "إدارة التخصصات";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-light mb-1">إدارة التخصصات 🛠️</h2>
            <p class="text-muted">أضف تخصصات جديدة للحرفيين أو قم بإيقاف التخصصات الحالية.</p>
        </div>
        <a asp-action="Create" class="btn fw-bold px-4 py-2" style="background-color: var(--lime); color: #000; border-radius: 8px;">
            + إضافة تخصص جديد
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success fw-bold text-center border-0" style="background-color: rgba(163, 230, 53, 0.1); color: var(--lime);">
            ✔️ @TempData["SuccessMessage"]
        </div>
    }

    <div class="card bg-dark border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead style="background-color: #1a1a1a;">
                <tr>
                    <th class="py-3 px-4">#</th>
                    <th class="py-3 px-4">اسم التخصص</th>
                    <th class="py-3 px-4 text-center">الحالة</th>
                    <th class="py-3 px-4 text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">لا توجد تخصصات مضافة بعد.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4 text-muted">@item.Id</td>
                            <td class="px-4 fw-bold text-light">@item.Name</td>
                            <td class="px-4 text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill">مفعل</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill">موقوف</span>
                                }
                            </td>
                            <td class="px-4 text-end">
                                <!-- زر التفعيل والإيقاف -->
                                <form asp-action="ToggleStatus" method="post" style="display: inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success") fw-bold rounded-3">
                                        @(item.IsActive ? "إيقاف ❌" : "تفعيل ✅")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>