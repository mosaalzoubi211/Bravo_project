@model IEnumerable<Bravo.Models.ServiceTask>
@{
    ViewData["Title"] = "لوحة المهام المتاحة";
}

<style>
    .bravo-task-card {
        background: var(--bg-surface);
        border: 2px solid #4a4a4a;
        border-radius: 14px;
        padding: 28px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
    }

        .bravo-task-card:hover {
            border-color: var(--lime);
            box-shadow: 0 10px 30px rgba(163, 230, 53, 0.15);
            transform: translateY(-6px);
        }
</style>

<main id="main">
    <section class="section">
        <div class="container container--wide">

            @if (TempData["SuccessMessage"] != null)
            {
                <div style="background-color: rgba(163, 230, 53, 0.1); border: 1px solid var(--lime); color: var(--fg-main); padding: 16px; border-radius: 8px; margin-bottom: 24px;">
                    <strong>نجاح:</strong> @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div style="background-color: rgba(248, 113, 113, 0.1); border: 1px solid #f87171; color: #f87171; padding: 16px; border-radius: 8px; margin-bottom: 24px;">
                    <strong>تنبيه:</strong> @TempData["ErrorMessage"]
                </div>
            }

            <div class="section-head" style="margin-bottom: 40px; border-bottom: 1px solid var(--border-color); padding-bottom: 20px;">
                <span class="eyebrow"><span class="dot" aria-hidden="true"></span>سوق العمل</span>
                <h2 style="margin-top: 8px;">الطلبات المتاحة حالياً.</h2>
                <p class="lede" style="margin-top: 10px;">تصفح طلبات العملاء، وقدم عرض سعرك على ما يناسبك.</p>
            </div>

            @if (!Model.Any())
            {
                <div style="text-align: center; padding: 80px 20px; background: var(--bg-surface); border-radius: 12px; border: 1px dashed var(--border-color);">
                    <p style="color: var(--fg-soft); font-size: 1.1rem;">لا يوجد طلبات جديدة متاحة في الوقت الحالي.</p>
                </div>
            }
            else
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
                    @foreach (var task in Model)
                    {
                        <div class="bravo-task-card">
                            <div>
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                                    <span style="background: #2a2a2a; color: var(--fg-main); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; border: 1px solid #333;">
                                        @(task.Category?.Name ?? "عام")
                                    </span>
                                    <span style="color: #fbbf24; font-size: 0.85rem; font-weight: 600;">يتلقى عروض 📢</span>
                                </div>

                                <h3 style="font-size: 1.1rem; margin-bottom: 12px; line-height: 1.5; color: var(--fg-main);">
                                    @(task.Description.Length > 80 ? task.Description.Substring(0, 80) + "..." : task.Description)
                                </h3>

                                <div style="color: var(--fg-soft); font-size: 0.9rem; margin-bottom: 8px;">
                                    <strong>العميل:</strong> @(task.Client?.FullName ?? "غير معروف")
                                </div>
                                <div style="color: var(--fg-soft); font-size: 0.9rem; margin-bottom: 8px;">
                                    <strong>العنوان:</strong> @task.Location
                                </div>
                                <div style="color: var(--fg-soft); font-size: 0.9rem; margin-bottom: 20px;">
                                    <strong>الموعد:</strong> @task.ScheduledDate.ToString("yyyy/MM/dd - hh:mm tt")
                                </div>
                            </div>

                            <!-- نموذج تقديم عرض سعر (Bidding Form) -->
                            <div style="margin-top: auto; border-top: 1px solid var(--border-color); padding-top: 16px;">
                                <form asp-action="SubmitOffer" method="post">
                                    <input type="hidden" name="taskId" value="@task.Id" />

                                    <div style="margin-bottom: 12px;">
                                        <input type="number" name="proposedPrice" required min="1" step="0.5" placeholder="سعرك المقترح (دينار)" style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 6px; background: #fff; color: #000; font-weight: bold; margin-bottom: 8px;" />

                                        <textarea name="workerMessage" required rows="2" placeholder="رسالة للعميل (أخبره لماذا يختارك)" style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 6px; background: #fff; color: #000; font-size: 0.9rem; resize: none;"></textarea>
                                    </div>

                                    <button type="submit" class="btn btn--primary" style="width: 100%; justify-content: center; background-color: var(--lime); color: #000;">
                                        تقديم العرض 🚀
                                    </button>
                                </form>
                            </div>

                        </div>
                    }
                </div>
            }
        </div>
    </section>
</main>