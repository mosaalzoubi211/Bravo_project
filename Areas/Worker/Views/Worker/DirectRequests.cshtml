@model IEnumerable<Bravo.Models.ServiceTask>
@{
    ViewData["Title"] = "الطلبات المباشرة الواردة";
}

<style>
    .bravo-task-card {
        background: var(--bg-surface);
        border: 2px solid #4a4a4a;
        border-radius: 14px;
        padding: 28px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
        height: 100%;
    }

        .bravo-task-card:hover {
            border-color: var(--lime);
            box-shadow: 0 10px 30px rgba(163, 230, 53, 0.15);
            transform: translateY(-6px);
        }
</style>

<main id="main">
    <section class="section">
        <div class="container container--wide">

            <div class="section-head" style="margin-bottom: 40px; border-bottom: 1px solid var(--border-color); padding-bottom: 20px;">
                <span class="eyebrow"><span class="dot" aria-hidden="true" style="background-color: #fbbf24;"></span>صندوق الوارد</span>
                <h2 style="margin-top: 8px;">طلبات موجهة لك شخصياً.</h2>
                <p class="lede" style="margin-top: 10px;">قم بمراجعة طلبات العملاء، حدد سعرك المناسب واقبل العمل، أو اعتذر إن كنت مشغولاً.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div style="background-color: rgba(163, 230, 53, 0.1); border: 1px solid var(--lime); color: var(--fg-main); padding: 16px; border-radius: 8px; margin-bottom: 24px;">
                    <strong>نجاح!</strong> @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div style="background-color: rgba(248, 113, 113, 0.1); border: 1px solid #f87171; color: #f87171; padding: 16px; border-radius: 8px; margin-bottom: 24px;">
                    <strong>خطأ:</strong> @TempData["ErrorMessage"]
                </div>
            }

            @if (!Model.Any())
            {
                <div style="text-align: center; padding: 80px 20px; background: var(--bg-surface); border-radius: 12px; border: 1px dashed var(--border-color);">
                    <p style="color: var(--fg-soft); font-size: 1.1rem;">صندوق الوارد فارغ. لا يوجد طلبات مباشرة جديدة في الوقت الحالي.</p>
                </div>
            }
            else
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 24px;">
                    @foreach (var task in Model)
                    {
                        <div class="bravo-task-card">
                            <div>
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                                    <span style="color: #fbbf24; font-size: 0.85rem; font-weight: 600;">طلب مخصص لك ⭐</span>
                                    <span style="background: rgba(0,0,0,0.3); color: var(--fg-soft); padding: 4px 10px; border-radius: 6px; font-size: 0.8rem;">
                                        @task.CreatedAt.ToString("yyyy/MM/dd")
                                    </span>
                                </div>

                                <h3 style="font-size: 1.1rem; margin-bottom: 16px; line-height: 1.5; color: var(--fg-main);">
                                    @task.Description
                                </h3>

                                <div style="background: rgba(0,0,0,0.2); padding: 12px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #333;">
                                    <div style="color: var(--fg-soft); font-size: 0.9rem; margin-bottom: 8px;">
                                        <strong>العميل:</strong> @(task.Client?.FullName ?? "غير معروف")
                                    </div>
                                    <div style="color: var(--fg-soft); font-size: 0.9rem; margin-bottom: 8px;">
                                        <strong>العنوان:</strong> @task.Location
                                    </div>
                                    <div style="color: var(--fg-soft); font-size: 0.9rem;">
                                        <strong>الموعد:</strong> @task.ScheduledDate.ToString("yyyy/MM/dd - hh:mm tt")
                                    </div>
                                </div>
                            </div>

                            <!-- نماذج التفاعل (قبول وتسعير / رفض) -->
                            <div style="margin-top: auto; border-top: 1px solid var(--border-color); padding-top: 16px;">

                                <!-- نموذج القبول مع تحديد السعر -->
                                <form asp-action="AcceptDirectRequest" method="post" style="margin-bottom: 12px;">
                                    <input type="hidden" name="taskId" value="@task.Id" />

                                    <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px;">
                                        <input type="number" name="price" required min="1" step="0.5" placeholder="حدد السعر (دينار)" style="flex: 1; padding: 10px; border: 1px solid var(--border-color); border-radius: 6px; background: #fff; color: #000; font-weight: bold;" />
                                    </div>

                                    <button type="submit" class="btn btn--primary" style="width: 100%; justify-content: center; background-color: var(--lime); color: #000;">
                                        قبول وتأكيد السعر ✔️
                                    </button>
                                </form>

                                <!-- نموذج الاعتذار -->
                                <form asp-action="DeclineDirectRequest" method="post">
                                    <input type="hidden" name="taskId" value="@task.Id" />
                                    <button type="submit" class="btn btn--ghost" style="width: 100%; justify-content: center; border-color: rgba(248, 113, 113, 0.3); color: #f87171;" onclick="return confirm('هل أنت متأكد من الاعتذار عن هذا الطلب؟');">
                                        الاعتذار عن التنفيذ ❌
                                    </button>
                                </form>

                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</main>