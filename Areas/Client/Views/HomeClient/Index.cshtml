@model IEnumerable<Bravo.Models.ServiceTask>
@{
    ViewData["Title"] = "الرئيسية - حساب العميل";
    // هذه الصفحة ستأخذ الـ Layout الرئيسي تلقائياً بفضل ملف _ViewStart.cshtml
}

<!-- واجهة الترحيب والبحث -->
<section class="hero-section">
    <div class="container">
        <h1 class="fw-bold mb-3">ابحث عن أمهر <span style="color: var(--lime);">الحرفيين</span> بسهولة</h1>
        <p class="mb-5" style="color: var(--text-muted); font-size: 1.1rem;">أفضل الصنايعية وأصحاب المهن اليدوية الموثوقين في خدمتك.</p>

        <div class="search-box">
            <!-- توجيه البحث داخل منطقة العميل -->
            <form asp-area="Client" asp-action="SearchWorkers" asp-controller="HomeClient" method="get">
                <input type="text" name="query" class="search-input" placeholder="ابحث عن مهنة (مثال: سباك، نجار، كهربائي...)" />
                <button type="submit" class="search-btn"><i class="bi bi-search me-1"></i> بحث</button>
            </form>
        </div>
    </div>
</section>

<!-- قسم الطلبات الحالية -->
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="m-0">طلباتي المفتوحة</h3>
        <a asp-area="Client" asp-action="CreateTask" asp-controller="HomeClient" class="btn btn--primary btn--sm">
            طلب خدمة جديدة
        </a>
    </div>

    <!-- شبكة عرض الطلبات -->
    <div class="row g-4">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12 text-center p-5 rounded-4" style="background-color: rgba(255,255,255,0.02); border: 1px dashed var(--border-color);">
                <i class="bi bi-inbox fs-1 d-block mb-2" style="color: var(--text-muted);"></i>
                <p class="m-0" style="color: var(--text-muted); font-size: 1.1rem;">لا توجد لديك طلبات مفتوحة حالياً. ابدأ بطلب خدمة جديدة!</p>
            </div>
        }
        else
        {
            foreach (var task in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="brav-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge" style="background-color: rgba(255,255,255,0.1); color: var(--text-main); font-weight: normal;">
                                @task.Status
                            </span>
                            <small style="color: var(--text-muted);">@task.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</small>
                        </div>

                        <h5 class="fw-bold mb-2">طلب خدمة رقم: @task.Id</h5>
                        <p style="color: var(--text-muted); font-size: 0.95rem; flex-grow: 1;">
                            الطلب متاح الآن، وبانتظار تقديم العروض من الحرفيين المعتمدين.
                        </p>

                        <hr style="border-color: var(--border-color);" />

                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span style="font-weight: bold; color: var(--lime);">
                                <i class="bi bi-bell-fill me-1"></i> عروض جديدة
                            </span>
                            <a asp-area="Client" asp-action="Details" asp-controller="HomeClient" asp-route-id="@task.Id" class="btn btn--ghost btn--sm">
                                التفاصيل
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>