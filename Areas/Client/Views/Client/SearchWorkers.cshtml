@model IEnumerable<Bravo.Models.AppUser>
@{
    ViewData["Title"] = "البحث عن حرفي";
}

<style>
    .bravo-task-card {
        background: var(--bg-surface);
        border: 2px solid #4a4a4a;
        border-radius: 14px;
        padding: 28px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
    }

        .bravo-task-card:hover {
            border-color: var(--lime);
            box-shadow: 0 10px 30px rgba(163, 230, 53, 0.15);
            transform: translateY(-6px);
        }
</style>

<main id="main">
    <section class="section">
        <div class="container container--wide">

            <!-- رأس الصفحة وشريط البحث -->
            <div class="section-head" style="margin-bottom: 40px; text-align: center;">
                <span class="eyebrow"><span class="dot" aria-hidden="true"></span>دليل الحرفيين</span>
                <h2 style="margin-top: 8px;">ابحث عن الخبير المناسب لمشكلتك.</h2>

                <form asp-controller="Search" asp-action="Index" method="get" style="margin-top: 32px; max-width: 800px; margin-left: auto; margin-right: auto; display: flex; gap: 12px; flex-wrap: wrap;">

                    <!-- فلتر نوع العمل (التخصص) -->
                    <select name="categoryId" asp-items="ViewBag.Categories" style="flex: 1; min-width: 200px; padding: 16px 24px; border: 2px solid var(--border-color); border-radius: 50px; background-color: #ffffff; color: #000; font-size: 1.1rem; font-weight: 500; outline: none; appearance: auto; cursor: pointer;">
                        <option value="" style="color: #000;">جميع التخصصات</option>
                    </select>

                    <!-- فلتر وصف العمل / الاسم -->
                    <input type="text" name="searchQuery" value="@ViewBag.SearchQuery" placeholder="ابحث في وصف الحرفي (مثال: خبير تمديدات، جبس بورد...)" style="flex: 2; min-width: 300px; padding: 16px 24px; border: 2px solid var(--border-color); border-radius: 50px; background-color: #ffffff; color: #000; font-size: 1.1rem; outline: none;" />

                    <button type="submit" class="btn btn--primary" style="border-radius: 50px; padding: 0 40px; font-size: 1.1rem;">
                        فرز وبحث 🔍
                    </button>
                </form>
            </div>

            <!-- عرض النتائج -->
            @if (!Model.Any())
            {
                <div style="text-align: center; padding: 80px 20px; background: var(--bg-surface); border-radius: 12px; border: 1px dashed var(--border-color);">
                    <p style="color: var(--fg-soft); font-size: 1.1rem;">لم نتمكن من العثور على حرفي يطابق بحثك. جرب كلمات مفتاحية أخرى.</p>
                </div>
            }
            else
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
                    @foreach (var worker in Model)
                    {
                        <div class="bravo-task-card">
                            <div>
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                                    <div>
                                        <h3 style="font-size: 1.4rem; color: var(--fg-main); margin-bottom: 4px;">@worker.FullName</h3>
                                        <div style="color: #fbbf24; font-size: 1.1rem;">
                                            ⭐ @worker.Rating.ToString("0.0")
                                        </div>
                                    </div>
                                    <span style="background: rgba(163, 230, 53, 0.1); color: var(--lime); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; border: 1px solid var(--lime);">
                                        موثق ✔️
                                    </span>
                                </div>

                                <div style="margin-bottom: 24px;">
                                    <span style="display: block; color: var(--fg-soft); font-size: 0.85rem; margin-bottom: 8px;">النبذة التعريفية والتخصص الدقيق:</span>
                                    <p style="color: var(--fg-main); line-height: 1.6; font-size: 0.95rem; background: rgba(0,0,0,0.2); padding: 12px; border-radius: 8px; border: 1px solid #333;">
                                        @(string.IsNullOrEmpty(worker.Bio) ? "هذا الحرفي لم يضف نبذة تعريفية بعد." : worker.Bio)
                                    </p>
                                </div>
                            </div>

                            <!-- زر لطلب الخدمة من هذا الحرفي تحديداً (سنربطه لاحقاً) -->
                            <div style="margin-top: auto;">
                                <a asp-controller="Client" asp-action="DirectRequest" asp-route-workerId="@worker.Id" class="btn btn--ghost" style="width: 100%; justify-content: center; border-color: var(--border-color);">
                                    طلب خدمة من @worker.FullName
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</main>