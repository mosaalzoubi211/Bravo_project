@model Bravo.Models.ServiceTask
@{
    ViewData["Title"] = "تقييم الحرفي";
}

<style>
    /* تصميم النجوم باستخدام CSS النقي */
    .rating-css {
        display: flex;
        flex-direction: row-reverse;
        justify-content: center;
        gap: 10px;
    }
    .rating-css input {
        display: none;
    }
    .rating-css label {
        font-size: 3rem;
        color: #444; /* لون النجمة غير المحددة */
        cursor: pointer;
        transition: color 0.2s;
    }
    .rating-css input:checked ~ label,
    .rating-css label:hover,
    .rating-css label:hover ~ label {
        color: #fbbf24; /* لون النجمة الذهبية (عند التحديد أو التمرير) */
    }
</style>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-lg border-0" style="background-color: var(--bg-surface); border-radius: 16px; border-top: 4px solid #fbbf24 !important;">
                <div class="card-body p-5 text-center">

                    <div style="font-size: 4rem; margin-bottom: 10px;">🏆</div>
                    <h2 class="text-light fw-bold mb-2">كيف كانت تجربتك؟</h2>
                    <p class="text-muted mb-4">أخبرنا برأيك في عمل الحرفي <strong>@Model.Worker?.FullName</strong> بخصوص: <br> <span class="text-lime">@Model.Description</span></p>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mb-4">@TempData["ErrorMessage"]</div>
                    }

                    <form asp-action="RateWorker" method="post">
                        <input type="hidden" name="taskId" value="@Model.Id" />

                        <!-- قسم اختيار النجوم -->
                        <div class="mb-4">
                            <div class="rating-css">
                                <input type="radio" name="rating" id="star5" value="5" required>
                                <label for="star5" title="ممتاز">★</label>

                                <input type="radio" name="rating" id="star4" value="4">
                                <label for="star4" title="جيد جداً">★</label>

                                <input type="radio" name="rating" id="star3" value="3">
                                <label for="star3" title="جيد">★</label>

                                <input type="radio" name="rating" id="star2" value="2">
                                <label for="star2" title="مقبول">★</label>

                                <input type="radio" name="rating" id="star1" value="1">
                                <label for="star1" title="سيء">★</label>
                            </div>
                        </div>

                        <!-- قسم التعليق النصي -->
                        <div class="mb-4 text-start">
                            <label class="form-label text-light fw-bold">كلمة شكر أو ملاحظة (اختياري)</label>
                            <textarea name="review" class="form-control bg-light text-dark p-3 rounded-3" rows="3" placeholder="مثال: شغل نظيف ومتقن وملتزم بالوقت..."></textarea>
                        </div>

                        <button type="submit" class="btn w-100 fw-bold fs-5 py-3 rounded-pill" style="background-color: var(--lime); color: #000;">
                            إرسال التقييم ⭐
                        </button>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>