@model Bravo.Models.AppUser
@{
    ViewData["Title"] = "الملف الشخصي";
}

<style>
    .profile-cover {
        height: 200px;
        background: linear-gradient(135deg, #1f1f1f, #3a3a3a);
        border-radius: 16px 16px 0 0;
        position: relative;
    }

    .profile-avatar {
        width: 120px;
        height: 120px;
        background-color: var(--lime);
        color: #000;
        font-size: 3rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 6px solid var(--bg-surface);
        position: absolute;
        bottom: -60px;
        right: 40px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

    .profile-content {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-top: none;
        border-radius: 0 0 16px 16px;
        padding: 80px 40px 40px 40px;
    }

    .info-label {
        color: var(--fg-soft);
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .info-value {
        color: var(--fg-main);
        font-size: 1.1rem;
        font-weight: 500;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid #333;
    }
</style>

<div class="container mt-5 mb-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center border-0 fw-bold mb-4" style="background-color: rgba(163, 230, 53, 0.1); color: var(--lime);">
            ✔️ @TempData["SuccessMessage"]
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="shadow-lg rounded-4">

                <!-- الغلاف والصورة الرمزية -->
                <div class="profile-cover">
                    <div class="profile-avatar">
                        @(Model.FullName.Substring(0, 1))
                    </div>
                </div>

                <!-- بيانات الملف الشخصي -->
                <div class="profile-content">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="fw-bold m-0 text-light">@Model.FullName</h2>
                        <span class="badge px-3 py-2 fs-6" style="background-color: #2a2a2a; color: var(--lime); border: 1px solid var(--lime);">
                            @(Model.Role == Bravo.Models.UserRole.Worker ? "حرفي ومقدم خدمات 👷‍♂️" : "عميل 👤")
                        </span>
                    </div>

                    <div class="row mt-5">
                        <div class="col-md-6">
                            <div class="info-label">رقم الهاتف</div>
                            <div class="info-value">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "لم يتم الإدخال" : Model.PhoneNumber)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-label">البريد الإلكتروني</div>
                            <div class="info-value">@Model.Email</div>
                        </div>
                        <div class="col-md-12">
                            <div class="info-label">العنوان</div>
                            <div class="info-value">@(string.IsNullOrEmpty(Model.Address) ? "لم يتم الإدخال" : Model.Address)</div>
                        </div>

                        <!-- بيانات الحرفي الإضافية -->
                        @if (Model.Role == Bravo.Models.UserRole.Worker)
                        {
                            <div class="col-md-12 mt-4">
                                <h5 class="text-lime fw-bold mb-3" style="color: var(--lime);">المعلومات المهنية</h5>
                            </div>
                            <div class="col-md-6">
                                <div class="info-label">التخصص</div>
                                <div class="info-value">@(Model.Category?.Name ?? "غير محدد")</div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-label">التقييم العام</div>
                                <div class="info-value text-warning fw-bold">⭐ @Model.Rating.ToString("0.0")</div>
                            </div>
                            <div class="col-md-12">
                                <div class="info-label">النبذة (Bio)</div>
                                <div class="info-value" style="border: none; background: rgba(0,0,0,0.2); padding: 16px; border-radius: 8px;">
                                    @(string.IsNullOrEmpty(Model.Bio) ? "لم يقم بكتابة نبذة بعد." : Model.Bio)
                                </div>
                            </div>
                        }
                    </div>

                    <!-- زر تعديل البيانات -->
                    <div class="mt-4 text-end">
                        <a asp-action="Edit" class="btn fw-bold px-4 py-2 rounded-pill" style="background-color: var(--lime); color: #000;">
                            تعديل البيانات ✏️
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>