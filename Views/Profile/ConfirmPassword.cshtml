@{
    ViewData["Title"] = "تأكيد الهوية";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 text-center" style="background-color: var(--bg-surface); border-radius: 16px;">
                <div class="card-body p-5">

                    <div style="font-size: 3rem; margin-bottom: 20px;">🔒</div>
                    <h3 class="text-light fw-bold mb-3">تأكيد التعديلات</h3>
                    <p class="text-muted mb-4">كإجراء أمني، يرجى إدخال كلمة المرور الخاصة بحسابك لاعتماد التغييرات التي قمت بها.</p>

                    <form asp-action="ConfirmPassword" method="post">

                        <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

                        <div class="mb-4 text-start">
                            <input type="password" name="password" class="form-control text-center bg-light text-dark p-3 rounded-3" placeholder="••••••••" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn fw-bold p-3 rounded-pill" style="background-color: var(--lime); color: #000;">
                                تأكيد وحفظ التغييرات
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary p-3 rounded-pill mt-2">إلغاء</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>